       <property name="styleSheet">
        <string notr="true">QTabBar::tab {
    width: 40px;     /* desired width */
    height: 40px;     /* desired height */
    font-size: 14px;
    padding: 5px;
    background: palette(window);
    color: palette(window-text);
border-right: 0px solid white;
  border-left: 5px solid  palette(window);  /* Purple stripe on the left */



}
QTabBar::tab:selected {
    background-color: white;  /* light gray for selected */
  border-left: 5px solid #800080;  /* Purple stripe on the left */
    background: transparent;
    color: black;
border-right: 5px solid white;


}
#Sidebar::tab{


    background-repeat: no-repeat;
    background-position: center;
    background-origin: content;
}
</string>
