    <property name="styleSheet">
     <string notr="true">QtabWidget {
    background-color: #f0f0f0; /* Light grey background for whole widget */
}

QtabWidget::pane {
  background-color: white;
    border: none; /* Removes the panel border */
}

QTabBar::tab {
    background: palette(window);
    border: none;
    padding: 3px 20px;
    margin-right: -1px; /* Hides the gap between tabs */
    font-size: 14px;
}

QTabBar::tab:hover {
    background: #a8dadc; /* Light blue on hover */
}

QTabBar::tab:selected {
    background: #800080; /* Darker blue when selected */
    color: white;
}</string>
